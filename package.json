{
  "name": "orcaq-monorepo",
  "private": true,
  "description": "The open source | Next Generation database editor",
  "homepage": "https://orca-q.com/",
  "author": {
    "name": "Cinny",
    "email": "chinhkhacnguyen29@gmail.com",
    "url": "https://github.com/cin12211"
  },
  "license": "MIT",
  "version": "1.1.17",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "nuxt:dev": "bun run --cwd apps/web nuxt:dev",
    "nuxt:build": "bun run --cwd apps/web nuxt:build",
    "nuxt:build-web": "bun run --cwd apps/web nuxt:build-web",
    "nuxt:generate": "bun run --cwd apps/web nuxt:generate",
    "electron:dev": "bun run --cwd apps/desktop electron:dev",
    "electron:compile": "bun run --cwd apps/desktop electron:compile",
    "electron:build": "bun run --cwd apps/desktop electron:build",
    "electron:build:mac-m": "bun run --cwd apps/desktop electron:build:mac-m",
    "electron:pack": "bun run --cwd apps/desktop electron:pack",
    "npx:build": "bun run --cwd apps/cli npx:build",
    "npx:pack": "bun run --cwd apps/cli npx:pack",
    "typecheck": "bun run --cwd apps/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "format:husky": "prettier $(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g') --write --ignore-unknown && git update-index --again",
    "version:patch": "npm version patch --no-git-tag-version && node scripts/sync-version.mjs",
    "version:minor": "npm version minor --no-git-tag-version && node scripts/sync-version.mjs",
    "version:major": "npm version major --no-git-tag-version && node scripts/sync-version.mjs",
    "storybook": "bun run --cwd apps/web storybook",
    "build-storybook": "bun run --cwd apps/web build-storybook",
    "depcruise:json": "bun run --cwd apps/web depcruise:json",
    "test:all": "bun run --cwd apps/web test:all",
    "test:unit": "bun run --cwd apps/web test:unit",
    "test:nuxt": "bun run --cwd apps/web test:nuxt",
    "test:api": "bun run --cwd apps/web test:api",
    "test:api:raw": "bun run --cwd apps/web test:api:raw",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:e2e:raw": "bun run --cwd apps/web test:e2e:raw",
    "test:e2e:mongodb": "bun run --cwd apps/web test:e2e:mongodb",
    "test:e2e:duckdb": "bun run --cwd apps/web test:e2e:duckdb",
    "test:coverage": "bun run --cwd apps/web test:coverage",
    "test:watch": "bun run --cwd apps/web test:watch",
    "test:fixtures:up": "bun run --cwd apps/web test:fixtures:up",
    "test:fixtures:down": "bun run --cwd apps/web test:fixtures:down"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=18.0.0"
  },
  "keywords": [
    "database",
    "query",
    "sql",
    "orm",
    "postgresql",
    "mysql",
    "desktop-app",
    "orca-q"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cin12211/orca-q.git"
  },
  "bugs": {
    "url": "https://github.com/cin12211/orca-q/issues"
  }
}
